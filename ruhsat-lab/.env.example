# Use the dedicated OCR host after its DNS and HTTPS are provisioned.
OTOTR_SERVER_ORIGIN=https://ocr.example.com
# Generate two different random values, at least 32 characters each.
OTOTR_API_TOKEN=
OTOTR_ADMIN_TOKEN=
OCR_RELEASE=0.3.3
# Optional CPU inference parallelism (1-16). Default: at most 6 logical CPUs.
# Benchmark on the deployment host before overriding.
# OTOTR_OCR_THREADS=6
