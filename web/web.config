<?xml version="1.0" encoding="utf-8"?>
<configuration><system.webServer>
<handlers><remove name="aspNetCore" /></handlers>
<defaultDocument><files><clear/><add value="index.php"/></files></defaultDocument>
<directoryBrowse enabled="false"/>
<rewrite><rules><rule name="OTOTR Web isolated routes" stopProcessing="true"><match url="^(?!assets/|index\.php$|catalog\.json$|web\.config$).*"/><conditions><add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true"/></conditions><action type="Rewrite" url="index.php" appendQueryString="true"/></rule></rules></rewrite>
<httpProtocol><customHeaders><remove name="X-Robots-Tag"/><add name="X-Robots-Tag" value="noindex, nofollow"/></customHeaders></httpProtocol>
</system.webServer></configuration>
