# X geliştirici panelinden alınan Bearer Token. Asla tarayıcıya veya Git deposuna koymayın.
X_BEARER_TOKEN=

# X API uç noktaları. Kurumsal erişimde farklı bir URL verilirse değiştirilebilir.
X_RECENT_SEARCH_URL=https://api.x.com/2/tweets/search/recent
X_ALL_SEARCH_URL=https://api.x.com/2/tweets/search/all
X_POST_LOOKUP_URL=https://api.x.com/2/tweets

# Sunucu
# Yönetim API anahtarı X anahtarından ayrıdır. Uzak ağda yayın yapılacaksa zorunlu kullanın.
ADMIN_API_TOKEN=
ALLOW_INSECURE_REMOTE=false

HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787

# Kalıcı medya saklama varsayılan olarak kapalıdır. OCR için medya geçici bellekte işlenir.
STORE_MEDIA=false
MEDIA_RETENTION_DAYS=7

# Tek taramada güvenlik sınırları
MAX_POSTS_PER_SCAN=100
MAX_IMAGE_BYTES=12582912
OCR_MIN_CONFIDENCE=35

# Demo modunu kapatmak için false yapın. X_BEARER_TOKEN yoksa sistem yine demo moduna geçer.
DEMO_MODE=true
